<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/DamasChinas_Server.Dtos" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/DamasChinas_Server.Dtos" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="ArrayOfLobbySummaryDto">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="LobbySummaryDto" nillable="true" type="tns:LobbySummaryDto" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfLobbySummaryDto" nillable="true" type="tns:ArrayOfLobbySummaryDto" />
  <xs:complexType name="LobbySummaryDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="CurrentPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="HostUsername" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="IsActive" type="xs:boolean" />
      <xs:element minOccurs="0" name="LobbyCode" type="xs:int" />
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="Visibility" type="tns:LobbyVisibility" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbySummaryDto" nillable="true" type="tns:LobbySummaryDto" />
  <xs:simpleType name="LobbyVisibility">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Public" />
      <xs:enumeration value="Private" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="LobbyVisibility" nillable="true" type="tns:LobbyVisibility" />
  <xs:complexType name="LobbySnapshotDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsGameStarted" type="xs:boolean" />
      <xs:element minOccurs="0" name="LobbyCode" type="xs:int" />
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="Members" nillable="true" type="tns:ArrayOfLobbyMemberDto" />
      <xs:element minOccurs="0" name="Visibility" type="tns:LobbyVisibility" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbySnapshotDto" nillable="true" type="tns:LobbySnapshotDto" />
  <xs:complexType name="ArrayOfLobbyMemberDto">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="LobbyMemberDto" nillable="true" type="tns:LobbyMemberDto" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfLobbyMemberDto" nillable="true" type="tns:ArrayOfLobbyMemberDto" />
  <xs:complexType name="LobbyMemberDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="AvatarFile" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="IsHost" type="xs:boolean" />
      <xs:element minOccurs="0" name="UserId" type="xs:int" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbyMemberDto" nillable="true" type="tns:LobbyMemberDto" />
  <xs:complexType name="CreateLobbyRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="Visibility" type="tns:LobbyVisibility" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="CreateLobbyRequest" nillable="true" type="tns:CreateLobbyRequest" />
  <xs:complexType name="JoinLobbyRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="LobbyCode" type="xs:int" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="JoinLobbyRequest" nillable="true" type="tns:JoinLobbyRequest" />
  <xs:complexType name="LobbyInvitationDto">
    <xs:sequence>
      <xs:element minOccurs="0" name="HostUsername" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="LobbyCode" type="xs:int" />
      <xs:element minOccurs="0" name="MaxPlayers" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbyInvitationDto" nillable="true" type="tns:LobbyInvitationDto" />
</xs:schema>