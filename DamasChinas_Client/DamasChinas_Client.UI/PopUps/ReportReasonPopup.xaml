<UserControl x:Class="DamasChinas_Client.UI.Popups.ReportReasonPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Background="#1E1E1E"
            BorderBrush="#FFD700"
            BorderThickness="2"
            CornerRadius="14"
            Padding="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource report}"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <RadioButton x:Name="rbSpam"
                             GroupName="Reasons"
                             Foreground="White"
                             FontSize="14"
                             Margin="0,6,0,0"
                             Content="{DynamicResource reportReason_SpamChat}" />

                <RadioButton x:Name="rbOffensive"
                             GroupName="Reasons"
                             Foreground="White"
                             FontSize="14"
                             Margin="0,6,0,0"
                             Content="{DynamicResource reportReason_OffensiveLanguage}" />

                <RadioButton x:Name="rbCheat"
                             GroupName="Reasons"
                             Foreground="White"
                             FontSize="14"
                             Margin="0,6,0,0"
                             Content="{DynamicResource reportReason_Cheating}" />

                <RadioButton x:Name="rbBadBehavior"
                             GroupName="Reasons"
                             Foreground="White"
                             FontSize="14"
                             Margin="0,6,0,0"
                             Content="{DynamicResource reportReason_InappropriateBehavior}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource cancel}"
                        Style="{DynamicResource BaseGameButton}"
                        Width="120" Height="36"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"/>

                <Button Content="{DynamicResource confirm}"
                        Style="{DynamicResource BaseGameButton}"
                        Width="120" Height="36"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
