<Page x:Class="DamasChinas_Client.UI.Pages.ProfilePublicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignHeight="720"
      d:DesignWidth="1280">

    <Grid>
        <!-- ===== FONDO ===== -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>
        <Rectangle Fill="#66000000"/>

        <!-- ===== CONTENEDOR PRINCIPAL ===== -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Encabezado -->
                <RowDefinition Height="*"/>
                <!-- Cuerpo -->
                <RowDefinition Height="Auto"/>
                <!-- Iconos inferiores -->
            </Grid.RowDefinitions>

            <!-- ===== ENCABEZADO ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Back -->
                <Button Width="60" Height="60"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{DynamicResource back}"
                        Click="OnBackClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="40"
                           Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{DynamicResource profile}"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           Foreground="White"
                           FontSize="42"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </Grid>

            <!-- ===== CUERPO ===== -->
            <Border Grid.Row="1"
                    Background="#80222222"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <!-- Información -->
                        <RowDefinition Height="1.3*"/>
                        <!-- Stats -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botón Add Friend -->
                    </Grid.RowDefinitions>

                    <!-- ===== INFORMACIÓN DEL PERFIL ===== -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Datos del usuario -->
                        <Grid Grid.Column="0" Margin="10,10,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource profile}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <!-- Username -->
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource username}"
                                           FontSize="24"
                                           Foreground="White"/>
                                <TextBlock x:Name="UsernameText"
                                           FontSize="20"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Social Media -->
                            <StackPanel Margin="0,25,0,0">
                                <TextBlock Text="{DynamicResource socialmedia}"
                                           FontSize="24"
                                           Foreground="White"/>
                                <TextBlock x:Name="SocialUrlText"
                                           FontSize="20"
                                           Text="{DynamicResource msg_FeatureUnavailable}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Avatar -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="220"
                                    Margin="0,0,10,0">

                            <Border Width="140" Height="140"
                                    BorderBrush="White"
                                    BorderThickness="3"
                                    CornerRadius="8"
                                    Margin="0,20">
                                <Image x:Name="AvatarImage"
                                       Stretch="UniformToFill"
                                       ClipToBounds="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- ===== ESTADÍSTICAS ===== -->
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource statistics}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="6,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource matchesPlayed}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="MatchesPlayedText" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource wins}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="WinsText" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource loses}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="LosesText" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== BOTÓN ADD FRIEND ===== -->
                    <Button Grid.Row="2"
                            Width="200"
                            Height="48"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource BaseGameButton}"
                            Content="{DynamicResource addFriend}"
                            Click="OnAddFriendClick"
                            Margin="0,30,0,0"/>
                </Grid>
            </Border>

            <!-- ===== ICONOS DERECHA INFERIOR ===== -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,10,10,0">

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSoundClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/soundIcon.png"
                           Width="26" Height="26"/>
                </Button>

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnLanguageClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/languageIcon.png"
                           Width="26" Height="26"/>
                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
