<Page x:Class="DamasChinas_Client.UI.Pages.ProfileUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280">

    <Grid>
        <!-- ===== FONDO ===== -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>
        <Rectangle Fill="#66000000"/>

        <!-- ===== CONTENEDOR PRINCIPAL ===== -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== ENCABEZADO ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Back -->
                <Button Width="60" Height="60"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource back}"
                        Cursor="Hand"
                        Click="OnBackClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="40" Height="40"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{DynamicResource profile}"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           Foreground="White"
                           FontSize="42"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </Grid>

            <!-- ===== CUERPO ===== -->
            <Border Grid.Row="1"
                    Background="#80222222"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25"
                    Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== INFORMACIÓN DEL INVITADO ===== -->
                    <StackPanel Grid.Column="0" Margin="20">
                        <TextBlock Text="{DynamicResource guestProfileTitle}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource username}"
                                   FontSize="24"
                                   Foreground="White"/>
                        <TextBlock x:Name="UsernameTextBlock"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,20"/>

                        <TextBlock Text="{DynamicResource guestProfileUnavailable}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Width="360"/>
                    </StackPanel>

                    <!-- ===== AVATAR ===== -->
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Width="220">

                        <Border Width="140" Height="140"
                                BorderBrush="White"
                                BorderThickness="3"
                                CornerRadius="8"
                                Margin="0,20">
                            <Image x:Name="AvatarImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ClipToBounds="True"/>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ===== ICONOS DERECHA INFERIOR ===== -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,10,10,0">

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource sound}"
                        Click="OnSoundClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/soundIcon.png"
                           Width="26" Height="26"/>
                </Button>

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource language}"
                        Click="OnLanguageClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/languageIcon.png"
                           Width="26" Height="26"/>
                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
