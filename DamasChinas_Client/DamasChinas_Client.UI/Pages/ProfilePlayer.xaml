<Page x:Class="DamasChinas_Client.UI.Pages.ProfilePlayer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280">

    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#66000000"/>

        <!-- CONTENEDOR -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Width="60" Height="60"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        ToolTip="{DynamicResource back}"
                        Click="OnBackClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="40" Height="40"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{DynamicResource profile}"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           Foreground="White"
                           FontSize="42"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </Grid>

            <!-- BODY -->
            <Border Grid.Row="1"
                    Background="#80222222"
                    CornerRadius="10"
                    Padding="25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="1.3*"/>
                    </Grid.RowDefinitions>

                    <!-- INFORMACIÓN PERFIL -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <!-- IZQUIERDA -->
                        <Grid Grid.Column="0" Margin="10,10,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header -->
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="{DynamicResource yourProfile}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,14"/>

                            <!-- Username -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,36,20,0">
                                <TextBlock Text="{DynamicResource username}" FontSize="24" Foreground="White"/>
                                <TextBlock x:Name="UsernameTextBlock"
                                           FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,36,0,0">
                                <TextBlock Text="{DynamicResource email}" FontSize="24" Foreground="White"/>
                                <TextBlock x:Name="EmailTextBlock"
                                           FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Full Name -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,20,0">
                                <TextBlock Text="{DynamicResource fullName}"
                                           FontSize="25" Foreground="White"/>
                                <TextBlock x:Name="FullNameTextBlock"
                                           FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Social Media -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,10,0,0">
                                <TextBlock Text="{DynamicResource socialmedia}"
                                           FontSize="25" Foreground="White"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/twitch.png"
                                           Width="28" Height="28" Margin="0,0,8,0"/>

                                    <Button x:Name="BtnOpenSocial"
                                            Content="{DynamicResource openLink}"
                                            Width="140" Height="34"
                                            Style="{DynamicResource BaseGameButton}"
                                            Click="OnOpenSocialClick"/>
                                </StackPanel>

                                <TextBlock x:Name="SocialUrlTextBlock"
                                           Margin="0,6,0,0"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- AVATAR -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="220">

                            <Button Width="140" Height="140"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="OnChangeAvatarClick">
                                <Image x:Name="AvatarImage"
                                       Width="120" Height="120"
                                       Stretch="UniformToFill"
                                       ClipToBounds="True"/>
                            </Button>

                            <Button Style="{DynamicResource BaseGameButton}"
                                    Content="{DynamicResource changeData}"
                                    Width="180" Height="44"
                                    Margin="0,10,0,10"
                                    Click="OnChangeDataClick"/>

                            <Button Style="{DynamicResource BaseGameButton}"
                                    Content="{DynamicResource logout}"
                                    Width="180" Height="44"
                                    Background="#444"
                                    BorderBrush="#333"
                                    Click="OnLogoutClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- ESTADISTICAS -->
                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource statistics}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="6,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource matchesPlayed}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="MatchesPlayedTextBlock"
                                           FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource wins}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="WinsTextBlock"
                                           FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource loses}" FontSize="23" Foreground="White"/>
                                <TextBlock x:Name="LosesTextBlock"
                                           FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- FOOTER ICONOS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource sound}"
                        Click="OnSoundClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/soundIcon.png"
                           Width="26" Height="26"/>
                </Button>

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource language}"
                        Click="OnLanguageClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/languageIcon.png"
                           Width="26" Height="26"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
