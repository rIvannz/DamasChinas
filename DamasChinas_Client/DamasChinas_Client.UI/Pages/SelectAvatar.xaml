<Page x:Class="DamasChinas_Client.UI.Pages.SelectAvatar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utilities="clr-namespace:DamasChinas_Client.UI.Utilities;assembly=DamasChinas_Client.UI"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignWidth="1280" d:DesignHeight="720">

    <Grid>

        <!-- Fondo -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#66000000"/>

        <!-- CONTENEDOR PRINCIPAL -->
        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0" Margin="0 0 0 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Back -->
                <Button Width="60" Height="60"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource back}"
                        Cursor="Hand"
                        Click="OnBackClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="40" Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{DynamicResource profile}"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           FontSize="42"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0" />
            </Grid>

            <!-- AVATARES -->
            <Border Grid.Row="1"
                    Background="#80222222"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="AvatarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="15" HorizontalAlignment="Center">

                                    <RadioButton GroupName="AvatarGroup"
                                                 Tag="{Binding}"
                                                 Checked="OnAvatarChecked">

                                        <RadioButton.Content>
                                            <Border BorderBrush="White"
                                                    BorderThickness="2"
                                                    CornerRadius="10"
                                                    Padding="3">

                                                <Image Source="{Binding}"
                                                       Width="120" Height="120"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </RadioButton.Content>
                                    </RadioButton>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Border>

            <!-- BOTÓN APLICAR -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Margin="0 20 10 0">

                <Button Style="{DynamicResource BaseGameButton}"
                        Content="{DynamicResource saveChanges}"
                        Width="200" Height="48"
                        Click="OnApplyClick"/>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
