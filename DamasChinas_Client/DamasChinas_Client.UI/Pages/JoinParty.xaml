<Page x:Class="DamasChinas_Client.UI.Pages.JoinParty"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280">

    <Grid>
        <!-- FONDO -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#66000000"/>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <Button Click="OnBackClick"
                        Background="Transparent"
                        BorderThickness="0">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="28" Height="28"/>
                </Button>

                <TextBlock Text="{DynamicResource joinParty}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           Foreground="White"/>
            </StackPanel>

            <!-- CONTENEDOR PRINCIPAL -->
            <Border Grid.Row="1" CornerRadius="12" Background="#22000000" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource availableGames}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <!-- LISTA DE PARTIDAS -->
                    <ListView x:Name="lstPublicLobbies"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              FontSize="14"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single">

                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="#33000000"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </ListView.Resources>

                        <ListView.View>
                            <GridView>

                                <GridViewColumn Header="{DynamicResource lobbyCode}" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Code}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="{DynamicResource host}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HostUsername}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="{DynamicResource players}" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PlayerCount}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="{DynamicResource private}" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsPrivate}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>

                    </ListView>

                    <!-- BOTONES -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button Content="{DynamicResource refresh}"
                                Style="{DynamicResource BaseGameButton}"
                                Width="150" Height="48"
                                Margin="0,0,15,0"
                                Click="OnRefreshClick"/>

                        <Button Content="{DynamicResource joinSelected}"
                                Style="{DynamicResource BaseGameButton}"
                                Width="150" Height="48"
                                Click="OnJoinSelectedClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- JOIN BY CODE -->
            <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="txtLobbyCode"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="8,2"
                             Background="White"
                             BorderBrush="#444"
                             GotFocus="OnCodeBoxGotFocus"
                             LostFocus="OnCodeBoxLostFocus"/>

                    <TextBlock x:Name="txtCodePlaceholder"
                               Text="{DynamicResource enterCodePlaceholder}"
                               Foreground="#888"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <Button Grid.Column="1"
                        Content="{DynamicResource joinByCode}"
                        Style="{DynamicResource BaseGameButton}"
                        Width="150" Height="36"
                        Margin="10,0,0,0"
                        Click="OnJoinByCodeClick"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
