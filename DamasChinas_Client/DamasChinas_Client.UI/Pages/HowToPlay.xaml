<Page x:Class="DamasChinas_Client.UI.Pages.HowToPlay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource SurfaceBrush}"
      d:DesignWidth="1280"
      d:DesignHeight="720">

    <Grid>
        <!-- ===== Fondo del tablero ===== -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Backgrounds/board-background.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- ===== Oscurecimiento ===== -->
        <Rectangle Fill="#66000000"/>

        <!-- ===== CONTENEDOR PRINCIPAL ===== -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- =================== HEADER ===================== -->
            <!-- ================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Width="60" Height="60"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        ToolTip="{DynamicResource back}"
                        Click="OnBackClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/backIcon.png"
                           Width="40" Height="40"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{DynamicResource howToPlayTitle}"
                           FontFamily="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Fonts/#Oups"
                           Foreground="White"
                           FontSize="42"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
            </Grid>

            <!-- ================================================= -->
            <!-- =================== CONTENT ==================== -->
            <!-- ================================================= -->
            <Border Grid.Row="1"
                    Background="#90222222"
                    CornerRadius="14"
                    Padding="30">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ===== INTRODUCTION ===== -->
                        <TextBlock Text="{DynamicResource howToPlayIntroTitle}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource howToPlayIntroText}"
                                   FontSize="17"
                                   Foreground="#DDFFFFFF"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,30"/>

                        <!-- ===== OBJECTIVE ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/targetIcon.png"
                                   Width="46" Height="46" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource howToPlayObjectiveTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="{DynamicResource howToPlayObjectiveText}"
                                           FontSize="16"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== PLAYERS ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/friendsIcon.png"
                                   Width="46" Height="46" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource howToPlayPlayersTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="{DynamicResource howToPlayPlayersText}"
                                           FontSize="16"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== BOARD ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/boardIcon.png"
                                   Width="46" Height="46" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource howToPlayBoardTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="{DynamicResource howToPlayBoardText}"
                                           FontSize="16"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== MOVES ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/moveIcon.png"
                                   Width="46" Height="46" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource howToPlayMovesTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="{DynamicResource howToPlayMovesText}"
                                           FontSize="16"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== WIN ===== -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/trophyIcon.png"
                                   Width="46" Height="46" Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource howToPlayWinTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="{DynamicResource howToPlayWinText}"
                                           FontSize="16"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================================================= -->
            <!-- =================== FOOTER ===================== -->
            <!-- ================================================= -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource sound}"
                        Click="OnSoundClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/soundIcon.png"
                           Width="26" Height="26"/>
                </Button>

                <Button Width="44" Height="44"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="{DynamicResource language}"
                        Click="OnLanguageClick">
                    <Image Source="pack://application:,,,/DamasChinas_Client.UI;component/Assets/Icons/languageIcon.png"
                           Width="26" Height="26"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
