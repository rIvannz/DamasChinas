<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<configSections>
		<sectionGroup name="userSettings"
       type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="DamasChinas_Client.Properties.Settings"
      type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
      allowExeDefinition="MachineToLocalUser"
      requirePermission="false" />
		</sectionGroup>
	</configSections>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<userSettings>
		<DamasChinas_Client.Properties.Settings>
			<setting name="languageCode" serializeAs="String">
				<value>en-Us</value>
			</setting>
		</DamasChinas_Client.Properties.Settings>
	</userSettings>

	<system.serviceModel>

	
		<bindings>
   <netTcpBinding>
    <binding name="netTcp_Normal" closeTimeout="00:00:10" openTimeout="00:00:10"
     receiveTimeout="00:10:00" sendTimeout="00:00:30">
     <security mode="None" />
    </binding>
	   <binding name="netTcp_Match"
			closeTimeout="00:00:10"
			openTimeout="00:00:10"
			receiveTimeout="00:02:00"
			sendTimeout="00:00:15">
		   <reliableSession enabled="false" />
		   <security mode="None" />
	   </binding>

	   <binding name="NetTcpBinding_IAccountManager">
     <security mode="None">
      <transport sslProtocols="None" />
     </security>
    </binding>
   </netTcpBinding>
  </bindings>


		<client>
   <endpoint address="net.tcp://localhost:8790/AccountManager/"
    binding="netTcpBinding" bindingConfiguration="netTcp_Normal"
    contract="AccountManagerServiceProxy.IAccountManager" name="NetTcpBinding_IAccountManager" />
   <endpoint address="net.tcp://localhost:8740/FriendService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Normal" contract="FriendServiceProxy.IFriendService"
    name="NetTcpBinding_IFriendService" />
   <endpoint address="net.tcp://localhost:8759/GuestSessionService/"
    binding="netTcpBinding" bindingConfiguration="netTcp_Normal"
    contract="GuestSessionServiceProxy.IGuestSessionService" name="NetTcpBinding_IGuestSessionService" />
   <endpoint address="net.tcp://localhost:8751/LobbyService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Normal" contract="LobbyServiceProxy.ILobbyService"
    name="NetTcpBinding_ILobbyService" />
   <endpoint address="net.tcp://localhost:8733/LoginService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Normal" contract="LogInServiceProxy.ILoginService"
    name="NetTcpBinding_ILoginService" />
   <endpoint address="net.tcp://localhost:8758/MatchService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Match" contract="MatchServiceProxy.IMatchService"
    name="NetTcpBinding_IMatchService" />
   <endpoint address="net.tcp://localhost:8755/ChatService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Normal" contract="MensajeriaService.IChatService"
    name="NetTcpBinding_IChatService" />
   <endpoint address="net.tcp://localhost:8757/RankingService/"
    binding="netTcpBinding" bindingConfiguration="netTcp_Normal"
    contract="RankingServiceProxy.IRankingService" name="NetTcpBinding_IRankingService" />
   <endpoint address="net.tcp://localhost:8756/SessionService/"
    binding="netTcpBinding" bindingConfiguration="netTcp_Normal"
    contract="SessionServiceProxy.ISessionService" name="NetTcpBinding_ISessionService" />
   <endpoint address="net.tcp://localhost:8734/SignInService/" binding="netTcpBinding"
    bindingConfiguration="netTcp_Normal" contract="SingInServiceProxy.ISingInService"
    name="NetTcpBinding_ISingInService" />
  </client>

	</system.serviceModel>
</configuration>
